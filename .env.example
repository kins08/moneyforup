# Скопируйте в .env и заполните своими значениями

# Токен бота: получите у @BotFather (/newbot)
BOT_TOKEN=123456789:AAaaBBccDDeeFFggHHiiJJkkLLmmNNoo

# Публичный HTTPS-адрес игры (Telegram Mini App открывается только по HTTPS)
# Например: https://moneyforup.example.com/moneyforup-tg.html
APP_URL=https://example.com/moneyforup-tg.html

# Origin статики, которым разрешён доступ к API (через запятую).
# Если пусто — разрешается origin из APP_URL (и https://web.telegram.org).
# Пример: CORS_ORIGINS=https://moneyforup1.pages.dev,https://web.telegram.org
CORS_ORIGINS=

# Порт HTTP-API, к которому обращается игра (должен быть доступен по HTTPS —
# поставьте nginx/Caddy перед ним либо задеплойте на Render/Fly/VPS).
# Хостинги (Render/Fly/Heroku) сами выставляют PORT — он имеет приоритет над API_PORT.
API_PORT=3000
# PORT=3000

# Ваш Telegram ID (узнать: @userinfobot). Нужен для подтверждения оплат по СБП
ADMIN_ID=123456789

# Публичный адрес бэкенда (без слэша на конце) — нужен для вебхуков Platega и Heleket.
# Например: https://api.ваш-домен.ru
PUBLIC_URL=

# Имя бота без @ (для реферальных ссылок t.me/<имя>). Если не задать — берётся из Telegram.
BOT_USERNAME=

# ---------- Platega: карты РФ и СБП ----------
# Кабинет platega.io → Настройки → API: merchant id и secret
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
# Боевой адрес. Если ваш кабинет требует префикс /v2 — поставьте https://app.platega.io/v2
PLATEGA_API=https://app.platega.io
# В кабинете Platega укажите Callback URL: https://<бэкенд>/platega-webhook
# (только HTTPS, публичный домен, валидный SSL — самоподписанные сертификаты не принимаются)

# ---------- Coinso: криптовалюта (USDT, TON, BTC, ETH) ----------
COINSO_PROJECT_ID=
COINSO_API_KEY=
COINSO_SECRET_KEY=

# ---------- Реквизиты для оплаты СБП и картами напрямую ----------
# Задаются только здесь, в открытый код клиентского приложения не попадают
SBP_PHONE=+79000000000
SBP_HOLDER=Иван И.
CARD_TINKOFF=
CARD_SBER=
CARD_OZON=

# Секретный ключ для авторизации вебхука SMS/Push-уведомлений (/api/payment-webhook).
# ОБЯЗАТЕЛЬНО задайте СВОЁ случайное значение (например: openssl rand -hex 24).
# Сервер ОТКЛОНЯЕТ вебхук, если секрет пуст или совпадает с публичным примером ниже,
# поэтому реальный секрет должен быть только в окружении (не в репозитории).
PAYMENT_WEBHOOK_SECRET=

# Доверять ли заголовку X-Forwarded-For при определении IP для rate-limit.
# 1 — только если приложение за доверенным прокси (Render/Fly/nginx). Иначе оставьте пустым:
# при прямом доступе XFF подделывается и обходит лимиты.
TRUST_PROXY=

# ---------- Turso (облачная персистентность между деплоями Render/Fly) ----------
# Необязательно: без этих переменных работает только локальный SQLite (DB_PATH).
# Сначала создать таблицы: node tools/init-turso.js
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Путь к постоянной базе данных SQLite (на Render обязательно подключить Persistent Disk, например: /var/data/moneyforup.db)
DB_PATH=data/moneyforup.db

# Режим тестирования (1 = отключает long polling и вызовы Telegram API при e2e-тестах)
BOT_DRY_RUN=0

